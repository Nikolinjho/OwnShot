<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSMultipleInstancesProhibited</key>
	<true/>
	<key>CFBundleIconFile</key>
	<string>SnapzyIcon</string>
	<key>CFBundleName</key>
	<string>$(SNAPZY_BUNDLE_NAME)</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Image</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.png</string>
				<string>public.jpeg</string>
				<string>public.heic</string>
				<string>public.heif</string>
				<string>public.tiff</string>
				<string>com.compuserve.gif</string>
				<string>org.webmproject.webp</string>
				<string>public.bmp</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>OwnShot Project</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSTypeIsPackage</key>
			<false/>
			<key>LSItemContentTypes</key>
			<array>
				<string>dev.nikoko.ownshot.project</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>dev.nikoko.ownshot.project</string>
			<key>UTTypeDescription</key>
			<string>OwnShot Project</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>ownshot</string>
				</array>
				<key>public.mime-type</key>
				<string>application/x-ownshot-project</string>
			</dict>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.nikoko.ownshot</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ownshot</string>
			</array>
		</dict>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>OwnShot needs microphone access to record audio with your screen recordings.</string>
	<key>NSCameraUsageDescription</key>
	<string>OwnShot needs camera access to add a camera overlay to your screen recordings.</string>
	<key>NSCameraUseContinuityCameraDeviceType</key>
	<true/>
	<key>NSScreenCaptureUsageDescription</key>
	<string>OwnShot needs screen recording permission to capture screenshots and record your screen.</string>
	<key>SUEnableAutomaticChecks</key>
	<false/>
</dict>
</plist>
